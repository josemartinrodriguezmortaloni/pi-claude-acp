{
  "name": "pi-claude-acp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension that runs Claude Code through ACP",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "prepare": "git config core.hooksPath .githooks",
    "complexity": "eslint src"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.84.0",
    "@agentclientprotocol/sdk": "1.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
